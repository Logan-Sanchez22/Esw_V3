# Copy this to .env and fill in real values.

# Client-safe, bundled into the app. Expo only auto-inlines vars prefixed
# EXPO_PUBLIC_ (not Next.js's NEXT_PUBLIC_ convention).
# Get from https://dashboard.clerk.com -> your app -> API Keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Server-only. Never prefix this with EXPO_PUBLIC_ — that would bundle it
# into client code. Used by src/app/api/ routes to verify a request's
# Clerk session server-side.
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Server-only. Neon Postgres connection string — get from
# https://console.neon.tech -> your project -> Connect.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
